# Copy to deploy/.env and fill in. Never commit deploy/.env — the .gitignore
# already excludes it.
#
#   cp deploy/.env.example deploy/.env

# ── Public address ───────────────────────────────────────────────────────
# The DNS A record for this must already point at the VM's public IP, or Caddy
# cannot issue a certificate. Confirm it before deploying:
#   curl -4 ifconfig.me
DOMAIN=aiworker.example.com

# Let's Encrypt uses this to warn about expiring certificates. It is optional,
# but strongly recommended — it is the only notice you get before expiry.
ACME_EMAIL=you@example.com

# ── Access control ───────────────────────────────────────────────────────
# Required. Caddy will not start without both.
CADDY_USER=demo

# bcrypt hash, NOT the plain password. Generate one with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'choose-a-password'
# or let scripts/oracle_setup.sh do it for you.
CADDY_HASH=$2a$14$PASTE_THE_HASH_HERE

# ── Agent behaviour ──────────────────────────────────────────────────────
# Offline by default: ScriptedClient is a deterministic policy engine and needs
# no external service. Switch to the real model by uncommenting these two lines
# — note that then anyone who passes the Caddy password spends your tokens.
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5

# How long a run waits for a human before denying its own approval. Do not set
# this much lower than a person plausibly needs to read a payment amount.
QUESTION_TIMEOUT_SECONDS=900

# 120 covers a single invoice (~31 steps) plus a small sweep.
AGENT_MAX_STEPS=120

LOG_LEVEL=INFO

# ── Fault injection ──────────────────────────────────────────────────────
# Off in production: with faults on, the demo includes a scenario where AP
# reports a successful save while writing nothing. Turn it on only to show it.
FAULT_INJECTION=false