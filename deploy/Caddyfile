# Caddy sits in front of the agent, terminates TLS with an automatically renewed
# Let's Encrypt certificate, and requires a password.
#
# Two settings in here are load-bearing, not decoration:
#
#   flush_interval -1   Without it Caddy buffers the response body, so the
#                       Server-Sent Events stream arrives at the browser in one
#                       lump when the run finishes. The live feed stops being
#                       live.
#   long read timeout   A parked run holds its SSE connection open for up to
#                       QUESTION_TIMEOUT_SECONDS while a human decides. The
#                       30s-ish defaults would cull it mid-run.
#
# CADDY_USER and CADDY_HASH come from deploy/.env. If either is unset this file
# fails to load rather than serving the agent unauthenticated, which is the
# intended behaviour: this app has no authentication of its own, and anyone who
# can reach it can start agent runs.

{
	email {$ACME_EMAIL:admin@example.com}
}

{$DOMAIN:localhost} {
	encode zstd gzip

	# Fail closed. Caddy rejects an empty username here, so forgetting to set
	# CADDY_USER stops the container instead of exposing the agent.
	basic_auth {
		{$CADDY_USER}
		{$CADDY_HASH}
	}

	reverse_proxy aiworker:8080 {
		# See the note at the top of this file.
		flush_interval -1
		transport http {
			read_timeout 3600s
			write_timeout 3600s
		}
	}

	header {
		# Run traces and screenshots are per-run state, never cacheable.
		Cache-Control -no-store
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# The UI is entirely self-hosted; no reason to advertise what it loads.
		-Server
	}

	log {
		output stdout
		format console
	}
}