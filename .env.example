# --- AI Worker -----------------------------------------------------------
# LLM (required only when LLM_PROVIDER=anthropic; the default offline provider
# is a scripted policy engine, so `python evals/run_eval.py` needs no external
# services)
LLM_PROVIDER=scripted
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_BASE_URL=
ANTHROPIC_MAX_TOKENS=4096

# --- Ports ---------------------------------------------------------------
ORCHESTRATOR_PORT=8000
VENDOR_PORTAL_PORT=8001
AP_SYSTEM_PORT=8002

# --- Paths ---------------------------------------------------------------
DATA_DIR=./data
RUNS_DIR=./runs
WORKSPACE_DIR=./workspace

# --- Seeded logins (simulated company apps) ------------------------------
VENDOR_PORTAL_USER=buyer@northwind.example
VENDOR_PORTAL_PASSWORD=portal-demo-2026
AP_SYSTEM_USER=ap@northwind.example
AP_SYSTEM_PASSWORD=ap-demo-2026

# --- Fault injection (off by default; on for demo + evals) ---------------
FAULT_INJECTION=false

# --- Agent budgets -------------------------------------------------------
# 120 is enough for a single invoice (~31 steps) plus a multi-invoice sweep.
AGENT_MAX_STEPS=120
AGENT_MAX_TOKENS=400000
AGENT_TIMEOUT_SECONDS=600
AGENT_MAX_REPAIRS=2

# --- Safety thresholds ---------------------------------------------------
APPROVAL_AMOUNT_THRESHOLD=10000
APPROVAL_AMOUNT_CURRENCY=USD

# --- Misc ----------------------------------------------------------------
LOG_LEVEL=INFO
SEED=20260401
# Frozen "today" so relative tasks ("due in the next 7 days") are deterministic
WORLD_TODAY=2026-04-01