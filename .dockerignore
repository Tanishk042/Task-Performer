# Keep the build context small and stop host state leaking into the image.
# Everything here is either regenerated by the seed, local-only, or huge.

.git
.gitignore
.github

# 181MB of local dependencies — the image installs its own from requirements.txt
.venv
venv

# Host run state. The container's equivalents live on the /data volume.
data
runs
workspace
downloads

# Local secrets. .env.example is fine to ship; a real .env never is.
.env
.env.*
!.env.example

# Python noise
__pycache__
*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache

# Docs and dev-only material: not needed to run the app.
tests
evals
ARCHITECTURE.md
README.md

.DS_Store